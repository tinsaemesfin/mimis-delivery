{
  "expo": {
    "name": "Mimis Delivery",
    "slug": "mimis-delivery",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mimisdelivery.app",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "mimisdelivery"
            ]
          }
        ],
        "NSPhotoLibraryUsageDescription": "We need access to save Excel files to your device.",
        "NSPhotoLibraryAddUsageDescription": "We need access to save Excel files to your device."
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.mimisdelivery.app",
      "versionCode": 2,
      "permissions": [
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "mimisdelivery"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "scheme": "mimisdelivery",
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": "We need access to save Excel files to your device.",
          "savePhotosPermission": "We need access to save Excel files to your device.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8f798de6-fd64-49df-8e39-b86e051c7c46"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/8f798de6-fd64-49df-8e39-b86e051c7c46"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "newArchEnabled": true
  }
}
