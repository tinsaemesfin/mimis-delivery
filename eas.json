{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote",
    "requireCommit": true 
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "WILL_BE_REPLACED_DURING_BUILD",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "WILL_BE_REPLACED_DURING_BUILD"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "WILL_BE_REPLACED_DURING_BUILD",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "WILL_BE_REPLACED_DURING_BUILD"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "WILL_BE_REPLACED_DURING_BUILD",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "WILL_BE_REPLACED_DURING_BUILD"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
