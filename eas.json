      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "gradleCommand": ":app:assembleDebug"
      },
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://kpsfqfntcfxejipieres.supabase.co",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "WILL_BE_REPLACED_DURING_BUILD"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
